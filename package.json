{
  "name": "news-bot",
  "version": "0.0.1",
  "description": "Personal Telegram bot that sends a daily AI / software-engineering news digest",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "fetch:once": "nest start --entryFile cli -- fetch",
    "digest:preview": "nest start --entryFile cli -- preview"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "better-sqlite3": "^11.10.0",
    "cron": "^4.4.0",
    "grammy": "^1.46.0",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/node": "^20.19.43",
    "typescript": "~5.7"
  }
}
