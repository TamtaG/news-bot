# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your personal chat id. Leave empty, start the bot, send it /start — it replies with the id.
TELEGRAM_CHAT_ID=

# Cron for the weekly digest (default: Monday 09:00) and the timezone it runs in
DIGEST_CRON=0 9 * * 1
TZ=Asia/Tbilisi

# How many items per digest (plan: 5–7)
DIGEST_SIZE=7
DIGEST_MAX_PER_SOURCE=3
# How far back the digest looks for unsent items (168 = one week)
DIGEST_LOOKBACK_HOURS=168
# v2: how many candidates the LLM ranks, and the lowest score that still makes the digest (0–10)
DIGEST_CANDIDATES=40
DIGEST_MIN_SCORE=6

DB_PATH=data/news.sqlite

# Ranking + advice — key from https://console.anthropic.com (no key = digest still works: score order, titles + links)
ANTHROPIC_API_KEY=
# Any Claude model id. claude-haiku-5-5 is ~40x cheaper and worth comparing.
LLM_MODEL=claude-opus-5-5
