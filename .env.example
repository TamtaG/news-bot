# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your personal chat id. Leave empty, start the bot, send it /start — it replies with the id.
TELEGRAM_CHAT_ID=

# Cron for the daily digest (default: 08:00 every day) and the timezone it runs in
DIGEST_CRON=0 8 * * *
TZ=Asia/Tbilisi

# How many items per digest
DIGEST_SIZE=10
DIGEST_MAX_PER_SOURCE=3

DB_PATH=data/news.sqlite

# v1 summaries — key from https://console.anthropic.com (no key = digest still works, just without summaries)
ANTHROPIC_API_KEY=
# Any Claude model id. claude-haiku-5-5 is ~40x cheaper and fine for summaries.
LLM_MODEL=claude-opus-5-5
